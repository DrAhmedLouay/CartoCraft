{
  "name": "CartoCraft Design System",
  "version": "1.0.0",
  "description": "Design tokens for CartoCraft - Cartographic Map Poster Creator",
  "primitive": {
    "color": {
      "purple": {
        "50": "#faf5ff",
        "100": "#f3e8ff",
        "200": "#e9d5ff",
        "300": "#d8b4fe",
        "400": "#c084fc",
        "500": "#a855f7",
        "600": "#9333ea",
        "700": "#7e22ce",
        "800": "#6b21a8",
        "900": "#581c87",
        "950": "#3b0764"
      },
      "pink": {
        "50": "#fdf2f8",
        "100": "#fce7f3",
        "200": "#fbcfe8",
        "300": "#f9a8d4",
        "400": "#f472b6",
        "500": "#ec4899",
        "600": "#db2777",
        "700": "#be185d",
        "800": "#9d174d",
        "900": "#831843",
        "950": "#500724"
      },
      "indigo": {
        "50": "#eef2ff",
        "100": "#e0e7ff",
        "200": "#c7d2fe",
        "300": "#a5b4fc",
        "400": "#818cf8",
        "500": "#6366f1",
        "600": "#4f46e5",
        "700": "#4338ca",
        "800": "#3730a3",
        "900": "#312e81",
        "950": "#1e1b4b"
      },
      "slate": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      },
      "neutral": {
        "white": "#ffffff",
        "black": "#000000",
        "transparent": "transparent"
      }
    },
    "spacing": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem"
    },
    "typography": {
      "fontFamily": {
        "sans": ["Space Grotesk", "system-ui", "-apple-system", "sans-serif"],
        "arabic": ["Noto Naskh Arabic", "system-ui", "sans-serif"],
        "display": ["Cairo", "system-ui", "sans-serif"],
        "mono": ["JetBrains Mono", "Fira Code", "monospace"]
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem",
        "6xl": "3.75rem"
      },
      "fontWeight": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700",
        "extrabold": "800",
        "black": "900"
      },
      "lineHeight": {
        "tight": "1.1",
        "snug": "1.375",
        "normal": "1.5",
        "relaxed": "1.625",
        "loose": "2"
      },
      "letterSpacing": {
        "tighter": "-0.05em",
        "tight": "-0.025em",
        "normal": "0",
        "wide": "0.025em",
        "wider": "0.05em",
        "widest": "0.1em"
      }
    },
    "borderRadius": {
      "none": "0",
      "sm": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem",
      "2xl": "1rem",
      "3xl": "1.5rem",
      "full": "9999px"
    },
    "shadow": {
      "xs": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "sm": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
      "2xl": "0 25px 50px -12px rgb(0 0 0 / 0.25)",
      "inner": "inset 0 2px 4px 0 rgb(0 0 0 / 0.05)",
      "glow-sm": "0 0 10px rgba(168, 85, 247, 0.3)",
      "glow-md": "0 0 20px rgba(168, 85, 247, 0.4), 0 0 40px rgba(236, 72, 153, 0.2)",
      "glow-lg": "0 0 30px rgba(168, 85, 247, 0.5), 0 0 60px rgba(236, 72, 153, 0.3)"
    },
    "zIndex": {
      "hide": "-1",
      "base": "0",
      "dropdown": "100",
      "sticky": "200",
      "fixed": "300",
      "modal-backdrop": "400",
      "modal": "500",
      "popover": "600",
      "tooltip": "700",
      "toast": "800"
    },
    "transition": {
      "fast": "150ms cubic-bezier(0.16, 1, 0.3, 1)",
      "normal": "200ms cubic-bezier(0.16, 1, 0.3, 1)",
      "slow": "300ms cubic-bezier(0.16, 1, 0.3, 1)",
      "slower": "500ms cubic-bezier(0.16, 1, 0.3, 1)",
      "bounce": "400ms cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    },
    "breakpoint": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    }
  },
  "semantic": {
    "color": {
      "background": {
        "primary": "{primitive.color.slate.950}",
        "secondary": "{primitive.color.slate.900}",
        "tertiary": "{primitive.color.slate.800}",
        "inverse": "{primitive.color.neutral.white}",
        "gradient-start": "{primitive.color.purple.950}",
        "gradient-end": "{primitive.color.pink.950}",
        "gradient-mid": "{primitive.color.indigo.950}"
      },
      "surface": {
        "primary": "rgba(30, 30, 58, 0.8)",
        "secondary": "rgba(22, 22, 42, 0.8)",
        "tertiary": "rgba(15, 15, 35, 0.9)",
        "glass": "rgba(30, 30, 58, 0.7)",
        "glass-strong": "rgba(30, 30, 58, 0.9)"
      },
      "border": {
        "primary": "rgba(168, 85, 247, 0.2)",
        "secondary": "rgba(168, 85, 247, 0.1)",
        "focus": "{primitive.color.purple.500}",
        "error": "{primitive.color.pink.500}"
      },
      "text": {
        "primary": "#e8e8f0",
        "secondary": "#b0b0d0",
        "muted": "#9090b0",
        "inverse": "#0f172a",
        "link": "{primitive.color.purple.400}",
        "link-hover": "{primitive.color.purple.300}"
      },
      "brand": {
        "primary": "{primitive.color.purple.500}",
        "primary-hover": "{primitive.color.purple.400}",
        "secondary": "{primitive.color.pink.500}",
        "secondary-hover": "{primitive.color.pink.400}",
        "accent": "{primitive.color.indigo.400}",
        "gradient": "linear-gradient(135deg, {primitive.color.purple.500}, {primitive.color.pink.500})",
        "gradient-hover": "linear-gradient(135deg, {primitive.color.purple.400}, {primitive.color.pink.400})"
      },
      "state": {
        "success": "#22c55e",
        "warning": "#f59e0b",
        "error": "{primitive.color.pink.500}",
        "info": "{primitive.color.indigo.400}"
      }
    },
    "spacing": {
      "none": "{primitive.spacing.0}",
      "xs": "{primitive.spacing.1}",
      "sm": "{primitive.spacing.2}",
      "md": "{primitive.spacing.4}",
      "lg": "{primitive.spacing.6}",
      "xl": "{primitive.spacing.8}",
      "2xl": "{primitive.spacing.12}",
      "3xl": "{primitive.spacing.16}"
    },
    "borderRadius": {
      "none": "{primitive.borderRadius.none}",
      "sm": "{primitive.borderRadius.sm}",
      "md": "{primitive.borderRadius.md}",
      "lg": "{primitive.borderRadius.lg}",
      "xl": "{primitive.borderRadius.xl}",
      "2xl": "{primitive.borderRadius.2xl}",
      "3xl": "{primitive.borderRadius.3xl}",
      "full": "{primitive.borderRadius.full}"
    },
    "shadow": {
      "none": "none",
      "xs": "{primitive.shadow.xs}",
      "sm": "{primitive.shadow.sm}",
      "md": "{primitive.shadow.md}",
      "lg": "{primitive.shadow.lg}",
      "xl": "{primitive.shadow.xl}",
      "2xl": "{primitive.shadow.2xl}",
      "inner": "{primitive.shadow.inner}",
      "glow": "{primitive.shadow.glow-md}",
      "glow-sm": "{primitive.shadow.glow-sm}",
      "glow-lg": "{primitive.shadow.glow-lg}"
    },
    "transition": {
      "fast": "{primitive.transition.fast}",
      "normal": "{primitive.transition.normal}",
      "slow": "{primitive.transition.slow}",
      "slower": "{primitive.transition.slower}",
      "bounce": "{primitive.transition.bounce}"
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": "{semantic.color.brand.gradient}",
        "background-hover": "{semantic.color.brand.gradient-hover}",
        "color": "{primitive.color.neutral.white}",
        "border": "none",
        "borderRadius": "{semantic.borderRadius.lg}",
        "padding": "{semantic.spacing.sm} {semantic.spacing.md}",
        "fontSize": "{primitive.typography.fontSize.sm}",
        "fontWeight": "{primitive.typography.fontWeight.bold}",
        "shadow": "{semantic.shadow.glow}",
        "shadow-hover": "{semantic.shadow.glow-lg}",
        "transition": "{semantic.transition.bounce}"
      },
      "secondary": {
        "background": "{semantic.surface.primary}",
        "background-hover": "rgba(168, 85, 247, 0.15)",
        "color": "{semantic.color.text.primary}",
        "border": "1.5px solid {semantic.color.border.primary}",
        "borderRadius": "{semantic.borderRadius.lg}",
        "padding": "{semantic.spacing.sm} {semantic.spacing.md}",
        "fontSize": "{primitive.typography.fontSize.sm}",
        "fontWeight": "{primitive.typography.fontWeight.semibold}",
        "transition": "{semantic.transition.normal}"
      },
      "ghost": {
        "background": "transparent",
        "background-hover": "rgba(168, 85, 247, 0.1)",
        "color": "{semantic.color.text.secondary}",
        "border": "1px solid transparent",
        "borderRadius": "{semantic.borderRadius.lg}",
        "padding": "{semantic.spacing.sm} {semantic.spacing.md}",
        "fontSize": "{primitive.typography.fontSize.sm}",
        "fontWeight": "{primitive.typography.fontWeight.semibold}",
        "transition": "{semantic.transition.normal}"
      },
      "icon": {
        "size": "44px",
        "borderRadius": "{semantic.borderRadius.full}",
        "transition": "{semantic.transition.bounce}"
      }
    },
    "input": {
      "background": "rgba(10, 10, 30, 0.6)",
      "background-focus": "rgba(10, 10, 30, 0.8)",
      "border": "1px solid {semantic.color.border.secondary}",
      "border-focus": "{semantic.color.border.focus}",
      "borderRadius": "{semantic.borderRadius.lg}",
      "padding": "{semantic.spacing.sm} {semantic.spacing.md}",
      "fontSize": "{primitive.typography.fontSize.base}",
      "color": "{semantic.color.text.primary}",
      "placeholder-color": "{semantic.color.text.muted}",
      "shadow-focus": "0 0 0 3px rgba(168, 85, 247, 0.15)",
      "transition": "{semantic.transition.normal}"
    },
    "card": {
      "background": "{semantic.surface.glass}",
      "border": "1px solid {semantic.color.border.secondary}",
      "borderRadius": "{semantic.borderRadius.xl}",
      "shadow": "{semantic.shadow.md}",
      "shadow-hover": "{semantic.shadow.glow-sm}",
      "padding": "{semantic.spacing.md}",
      "transition": "{semantic.transition.normal}"
    },
    "sidebar": {
      "width": "380px",
      "background": "{semantic.surface.glass-strong}",
      "border": "1px solid {semantic.color.border.secondary}",
      "shadow": "{semantic.shadow.2xl}, {semantic.shadow.glow-sm}",
      "backdropFilter": "blur(20px) saturate(180%)"
    },
    "header": {
      "height": "64px",
      "background": "rgba(10, 10, 30, 0.95)",
      "border": "1px solid {semantic.color.border.secondary}",
      "shadow": "{semantic.shadow.lg}, {semantic.shadow.glow-sm}",
      "backdropFilter": "blur(20px)"
    },
    "poster": {
      "background": "{semantic.color.background.primary}",
      "borderRadius": "{semantic.borderRadius.lg}",
      "shadow": "{semantic.shadow.2xl}, {semantic.shadow.glow-md}",
      "border": "1px solid rgba(255, 255, 255, 0.1)"
    },
    "tab": {
      "padding": "{semantic.spacing.sm} {semantic.spacing.xs}",
      "borderRadius": "{semantic.borderRadius.lg}",
      "fontSize": "{primitive.typography.fontSize.xs}",
      "fontWeight": "{primitive.typography.fontWeight.bold}",
      "color": "{semantic.color.text.muted}",
      "color-active": "{primitive.color.neutral.white}",
      "background-active": "rgba(168, 85, 247, 0.2)",
      "indicator-color": "{semantic.color.brand.gradient}",
      "transition": "{semantic.transition.normal}"
    },
    "themeCard": {
      "background": "{primitive.color.neutral.white}",
      "border": "1.5px solid {primitive.color.slate.200}",
      "borderRadius": "{semantic.borderRadius.lg}",
      "shadow": "{semantic.shadow.sm}",
      "shadow-hover": "{semantic.shadow.xl}",
      "padding": "{semantic.spacing.sm}",
      "transition": "{semantic.transition.bounce}"
    },
    "tooltip": {
      "background": "{semantic.color.background.primary}",
      "color": "{semantic.color.text.primary}",
      "border": "1px solid {semantic.color.border.primary}",
      "borderRadius": "{semantic.borderRadius.md}",
      "padding": "{semantic.spacing.xs} {semantic.spacing.sm}",
      "fontSize": "{primitive.typography.fontSize.xs}",
      "shadow": "{semantic.shadow.lg}",
      "transition": "{semantic.transition.fast}"
    },
    "toast": {
      "background": "{semantic.color.background.secondary}",
      "color": "{semantic.color.text.primary}",
      "border": "1px solid {semantic.color.border.primary}",
      "borderRadius": "{semantic.borderRadius.lg}",
      "padding": "{semantic.spacing.sm} {semantic.spacing.md}",
      "fontSize": "{primitive.typography.fontSize.sm}",
      "shadow": "{semantic.shadow.xl}",
      "transition": "{semantic.transition.bounce}"
    }
  },
  "animation": {
    "keyframes": {
      "fadeIn": {
        "0%": "{ opacity: 0 }",
        "100%": "{ opacity: 1 }"
      },
      "fadeOut": {
        "0%": "{ opacity: 1 }",
        "100%": "{ opacity: 0 }"
      },
      "slideInUp": {
        "0%": "{ opacity: 0; transform: translateY(20px) }",
        "100%": "{ opacity: 1; transform: translateY(0) }"
      },
      "slideInDown": {
        "0%": "{ opacity: 0; transform: translateY(-20px) }",
        "100%": "{ opacity: 1; transform: translateY(0) }"
      },
      "slideInLeft": {
        "0%": "{ opacity: 0; transform: translateX(-30px) }",
        "100%": "{ opacity: 1; transform: translateX(0) }"
      },
      "slideInRight": {
        "0%": "{ opacity: 0; transform: translateX(30px) }",
        "100%": "{ opacity: 1; transform: translateX(0) }"
      },
      "scaleIn": {
        "0%": "{ opacity: 0; transform: scale(0.9) }",
        "100%": "{ opacity: 1; transform: scale(1) }"
      },
      "scaleOut": {
        "0%": "{ opacity: 1; transform: scale(1) }",
        "100%": "{ opacity: 0; transform: scale(0.9) }"
      },
      "rotateIn": {
        "0%": "{ opacity: 0; transform: rotate(-180deg) scale(0.5) }",
        "100%": "{ opacity: 1; transform: rotate(0) scale(1) }"
      },
      "underlineGrow": {
        "0%": "{ width: 0; opacity: 0 }",
        "100%": "{ width: 40%; opacity: 1 }"
      },
      "shimmer": {
        "0%": "{ background-position: -200% 0 }",
        "100%": "{ background-position: 200% 0 }"
      },
      "spin": {
        "0%": "{ transform: rotate(0deg) }",
        "100%": "{ transform: rotate(360deg) }"
      },
      "spinReverse": {
        "0%": "{ transform: rotate(0deg) }",
        "100%": "{ transform: rotate(-360deg) }"
      },
      "pulseGlow": {
        "0%, 100%": "{ box-shadow: 0 0 20px rgba(168, 85, 247, 0.3), 0 0 40px rgba(168, 85, 247, 0.1) }",
        "50%": "{ box-shadow: 0 0 30px rgba(168, 85, 247, 0.5), 0 0 60px rgba(168, 85, 247, 0.2) }"
      },
      "float": {
        "0%, 100%": "{ transform: translateY(0) }",
        "50%": "{ transform: translateY(-10px) }"
      },
      "morph": {
        "0%, 100%": "{ border-radius: 12px }",
        "25%": "{ border-radius: 24px 12px 24px 12px }",
        "50%": "{ border-radius: 12px 24px 12px 24px }",
        "75%": "{ border-radius: 24px 12px 12px 24px }"
      },
      "rippleEffect": {
        "0%": "{ transform: scale(0); opacity: 0.4 }",
        "100%": "{ transform: scale(2.5); opacity: 0 }"
      },
      "colorPulse": {
        "0%": "{ box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.6) }",
        "50%": "{ box-shadow: 0 0 0 8px rgba(168, 85, 247, 0) }",
        "100%": "{ box-shadow: 0 0 0 0 rgba(168, 85, 247, 0) }"
      },
      "themeCardIn": {
        "0%": "{ opacity: 0; transform: translateY(20px) scale(0.95) }",
        "100%": "{ opacity: 1; transform: translateY(0) scale(1) }"
      },
      "themeSelectCelebrate": {
        "0%": "{ transform: scale(1); box-shadow: 0 0 0 0 var(--color-accent) }",
        "25%": "{ transform: scale(1.05); box-shadow: 0 0 0 10px rgba(168, 85, 247, 0.5) }",
        "50%": "{ transform: scale(0.98); box-shadow: 0 0 0 5px var(--color-accent) }",
        "100%": "{ transform: scale(1); box-shadow: 0 0 0 3px var(--color-accent) }"
      },
      "glowRotate": {
        "0%": "{ transform: rotate(0deg) }",
        "100%": "{ transform: rotate(360deg) }"
      },
      "toastSlideIn": {
        "0%": "{ opacity: 0; transform: translateX(100%) translateY(-50%) }",
        "100%": "{ opacity: 1; transform: translateX(0) translateY(-50%) }"
      },
      "focusGlow": {
        "0%": "{ box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.4) }",
        "50%": "{ box-shadow: 0 0 0 8px rgba(168, 85, 247, 0) }",
        "100%": "{ box-shadow: 0 0 0 0 rgba(168, 85, 247, 0) }"
      },
      "checkPop": {
        "0%": "{ transform: scale(1) }",
        "50%": "{ transform: scale(1.3) }",
        "100%": "{ transform: scale(1) }"
      }
    },
    "utilities": {
      "animate-fade-in": "fadeIn 0.3s ease-out forwards",
      "animate-fade-out": "fadeOut 0.2s ease-in forwards",
      "animate-slide-up": "slideInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards",
      "animate-slide-down": "slideInDown 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards",
      "animate-slide-left": "slideInLeft 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards",
      "animate-slide-right": "slideInRight 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards",
      "animate-scale-in": "scaleIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards",
      "animate-scale-out": "scaleOut 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards",
      "animate-rotate-in": "rotateIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards",
      "animate-underline-grow": "underlineGrow 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards",
      "animate-shimmer": "shimmer 3s ease-in-out infinite",
      "animate-spin": "spin 1s linear infinite",
      "animate-spin-reverse": "spinReverse 1.5s linear infinite",
      "animate-pulse-glow": "pulseGlow 2s ease-in-out infinite",
      "animate-float": "float 6s ease-in-out infinite",
      "animate-morph": "morph 8s ease-in-out infinite",
      "animate-ripple": "rippleEffect 0.6s ease-out forwards",
      "animate-color-pulse": "colorPulse 0.3s ease forwards",
      "animate-theme-card-in": "themeCardIn 0.5s ease forwards",
      "animate-theme-celebrate": "themeSelectCelebrate 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards",
      "animate-glow-rotate": "glowRotate 2s linear infinite",
      "animate-toast-in": "toastSlideIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards",
      "animate-focus-glow": "focusGlow 0.3s ease",
      "animate-check-pop": "checkPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards"
    },
    "stagger": {
      "delay-base": "80ms",
      "delay-section": "100ms",
      "delay-item": "60ms"
    },
    "reducedMotion": {
      "disableAnimations": true,
      "transitionDuration": "0.01ms"
    }
  }
}